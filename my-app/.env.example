# Required. Signs the httpOnly session cookie. Use a long random value.
SESSION_SECRET=

# Movie API used by the Next.js server routes.
BACKEND_URL=http://localhost:9090

# Public origin used in password-reset links. Do not take this from the request.
APP_ORIGIN=http://localhost:3000

# Card numbers and security codes are sent only to Stripe. Bookings are created
# after a PaymentIntent succeeds. Leave blank to refuse checkout.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
